[Unit]
Description=Draai de Waterlab-nowcast elke nacht om 03:00

[Timer]
OnCalendar=*-*-* 03:00:00
# Stond de machine om 03:00 uit, dan alsnog draaien bij de eerstvolgende start.
# Zonder dit staat er na een reboot dagenlang een verouderde verwachting.
Persistent=true

[Install]
WantedBy=timers.target
